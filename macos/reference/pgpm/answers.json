e"},{"t":"║                                    |                 |   80-bit: ~384 yrs  ║\n","x":9,"y":1826,"w":731.25,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"pre.ascii-table","ws":"pre"},{"t":"║                                    |                 |   120-bit: 10¹⁹ yrs ║\n","x":9,"y":1845,"w":731.25,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"pre.ascii-table","ws":"pre"},{"t":"║                                    |                 |   180-bit: 10⁴⁰ yrs ║\n","x":9,"y":1864,"w":731.25,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"pre.ascii-table","ws":"pre"},{"t":"╚═════════════════════════════════════════════════════════════════════════╝\n","x":9,"y":1883,"w":703.13,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"pre.ascii-table","ws":"pre"},{"t":"        ","x":9,"y":1902,"w":75,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"pre.ascii-table","ws":"pre"},{"t":"Memoro Vault uses this to classify your vault strength:","x":8,"y":1938,"w":515.63,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"p"},{"t":"Very Weak","x":52,"y":1973,"w":84.38,"h":19,"c":"rgb(204, 204, 204)","fs":"16px","el":"strong.metric-bad"},{"t":": under 40 bits — crackable in seconds to minutes","x":136.38,"y":1973,"w":459.37,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"li"},{"t":"Weak","x":52,"y":1992,"w":37.5,"h":19,"c":"rgb(204, 204, 204)","fs":"16px","el":"strong.metric-warn"},{"t":": 40–79 bits — crackable in minutes to months","x":89.5,"y":1992,"w":421.88,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"li"},{"t":"Moderate","x":52,"y":2011,"w":75,"h":19,"c":"rgb(204, 204, 204)","fs":"16px","el":"strong.metric-mid"},{"t":": 80–119 bits — could take decades to millions of years","x":127,"y":2011,"w":515.63,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"li"},{"t":"Strong","x":52,"y":2030,"w":56.25,"h":19,"c":"rgb(204, 204, 204)","fs":"16px","el":"strong.metric-strong"},{"t":": 120–179 bits — would take longer than the age of the universe using today’s best hardware","x":108.25,"y":2030,"w":853.13,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"li"},{"t":"Very Strong","x":52,"y":2049,"w":103.13,"h":19,"c":"rgb(204, 204, 204)","fs":"16px","el":"strong.metric-very"},{"t":": 180+ bits — beyond the reach of any current or foreseeable brute-force attack","x":155.13,"y":2049,"w":740.62,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"li"},{"t":"Even one weak answer can collapse your vault. To strengthen it:","x":8,"y":2084,"w":590.63,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"p"},{"t":"Use answers that only trusted people would know — not Google, Facebook, or public records","x":52,"y":2119,"w":834.38,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"li"},{"t":"Avoid names, birthplaces, and dates — these can often be socially engineered","x":52,"y":2138,"w":712.5,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"li"},{"t":"Use symbolic, metaphorical, or abstract memories, not surface facts","x":52,"y":2157,"w":628.13,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"li"},{"t":"Mix short and long structures and avoid patterns (like “john2024”)","x":52,"y":2176,"w":618.75,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"li"},{"t":"Memoro Vault provides no hints, no partial credit, and no feedback on incorrect input. To unlock the","x":8,"y":2211,"w":937.5,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"p"},{"t":" vault, users must enter the exact correct answers for all questions, and for six of them, they must also","x":8,"y":2230,"w":975,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"p"},{"t":" provide the correct order. This creates a layered security model: the decryption key is only derived if","x":8,"y":2249,"w":965.63,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"p"},{"t":" every answer is 100% accurate, and the six ordered answers match the precise sequence used during vault","x":8,"y":2268,"w":965.63,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"p"},{"t":" creation. With no indication of which part is wrong, attackers must blindly guess both content and order","x":8,"y":2287,"w":975,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"p"},{"t":" across hundreds of possibilities—making brute-force attempts impractical and expensive.","x":8,"y":2306,"w":815.63,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"p"},{"t":"Saved Seed or Password Files","x":8,"y":1483,"w":262.5,"h":19,"c":"rgb(242, 242, 242)","fs":"16px","el":"h2.section-title","tt":"uppercase"},{"t":"Seed File/Password Name:","x":8,"y":1521,"w":225,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"label"},{"t":"Seed Phrase or Password:","x":8,"y":1575,"w":225,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"label"},{"t":"Save Password/Seed File","x":17.38,"y":1669,"w":215.62,"h":19,"c":"rgb(204, 204, 204)","fs":"16px","el":"button.button","ws":"nowrap"},{"t":"Optional: Upload Documents to Include in Your Vault","x":8,"y":1716,"w":478.13,"h":19,"c":"rgb(204, 204, 204)","fs":"16px","el":"label.field-label-lg"},{"t":"Choose Files","x":24,"y":1741,"w":112.5,"h":19,"c":"rgb(204, 204, 204)","fs":"16px","el":"label#fileUploadLabel"},{"t":"No files uploaded","x":164.5,"y":1741,"w":159.38,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"span#fileUploadStatus.upload-status"},{"t":"You can upload files like text notes, images, videos, or scanned documents.","x":8,"y":1766,"w":703.13,"h":19,"c":"rgb(118, 118, 118)","fs":"16px","el":"p.note"},{"t":"Optional: Final Message for Yourself or Your Family","x":8,"y":1829,"w":478.13,"h":19,"c":"rgb(204, 204, 204)","fs":"16px","el":"label.field-label-lg"},{"t":"This message will be stored securely with your vault.","x":8,"y":1936,"w":496.88,"h":19,"c":"rgb(118, 118, 118)","fs":"16px","el":"p.note"},{"t":"← Back","x":17.38,"y":1999,"w":56.25,"h":19,"c":"rgb(204, 204, 204)","fs":"16px","el":"button.button","ws":"nowrap"},{"t":"Create Vault","x":111.13,"y":1999,"w":112.5,"h":19,"c":"rgb(242, 242, 242)","fs":"16px","el":"button.button","ws":"nowrap"},{"t":"Reset Timer","x":261.1