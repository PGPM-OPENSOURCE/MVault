,{"t":" across hundreds of possibilities—making brute-force attempts impractical and expensive.","x":8,"y":2553,"w":815.63,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"p"},{"t":"Saved Seed or Password Files","x":8,"y":1730,"w":262.5,"h":19,"c":"rgb(242, 242, 242)","fs":"16px","el":"h2.section-title","tt":"uppercase"},{"t":"Seed File/Password Name:","x":8,"y":1768,"w":225,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"label"},{"t":"Seed Phrase or Password:","x":8,"y":1822,"w":225,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"label"},{"t":"Save Password/Seed File","x":17.38,"y":1916,"w":215.62,"h":19,"c":"rgb(204, 204, 204)","fs":"16px","el":"button.button","ws":"nowrap"},{"t":"btc_cold_storage.txt","x":9,"y":1956,"w":187.5,"h":19,"c":"rgb(242, 242, 242)","fs":"16px","el":"strong"},{"t":"abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about","x":9,"y":1975,"w":871.88,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"code"},{"t":"Remove","x":18.38,"y":2002,"w":56.25,"h":19,"c":"rgb(231, 72, 86)","fs":"16px","el":"button.button.seed-remove-btn","ws":"nowrap"},{"t":"Optional: Upload Documents to Include in Your Vault","x":8,"y":2050,"w":478.13,"h":19,"c":"rgb(204, 204, 204)","fs":"16px","el":"label.field-label-lg"},{"t":"Choose Files","x":24,"y":2075,"w":112.5,"h":19,"c":"rgb(204, 204, 204)","fs":"16px","el":"label#fileUploadLabel"},{"t":"1 file uploaded","x":164.5,"y":2075,"w":140.63,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"span#fileUploadStatus.upload-status"},{"t":"You can upload files like text notes, images, videos, or scanned documents.","x":8,"y":2100,"w":703.13,"h":19,"c":"rgb(118, 118, 118)","fs":"16px","el":"p.note"},{"t":"accounts.txt (0 KB)","x":9,"y":2156,"w":178.13,"h":19,"c":"rgb(204, 204, 204)","fs":"16px","el":"span.upload-label","ws":"nowrap"},{"t":"Remove","x":208.5,"y":2156,"w":56.25,"h":19,"c":"rgb(231, 72, 86)","fs":"16px","el":"button.btn.btn-remove-upload","ws":"nowrap"},{"t":"Optional: 