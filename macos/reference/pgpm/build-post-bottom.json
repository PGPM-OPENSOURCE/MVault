{"url":"build-vault.html","title":"Building Your Vault - Memoro Vault","vw":1000,"vh":672,"dpr":2,"sx":0,"sy":0,"sh":672,"cw":1000,"active":"body","texts":[{"t":"[+] Full vault and paper PDF created.","x":8,"y":18,"w":346.88,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"div#progressLabel.progress-label"},{"t":"Back to Answers","x":17.38,"y":114,"w":140.62,"h":19,"c":"rgb(204, 204, 204)","fs":"16px","el":"button","ws":"nowrap"},{"t":"Retry Download","x":195.5,"y":114,"w":131.25,"h":19,"c":"rgb(204, 204, 204)","fs":"16px","el":"button","ws":"nowrap"},{"t":"Return to Dashboard","x":364.25,"y":114,"w":178.13,"h":19,"c":"rgb(204, 204, 204)","fs":"16px","el":"button","ws":"nowrap"},{"t":"Please Read Carefully","x":9,"y":-344,"w":196.88,"h":19,"c":"rgb(242, 242, 242)","fs":"16px","el":"h2"},{"t":"Your Memoro Vault has been successfully built and downloaded.","x":9,"y":-306,"w":571.88,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"p"},{"t":"To ensure it remains accessible for decades, it's critical to guard against ","x":9,"y":-271,"w":712.5,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"p"},{"t":"bit rot","x":721.5,"y":-271,"w":65.63,"h":19,"c":"rgb(204, 204, 204)","fs":"16px","el":"strong"},{"t":" — a slow form of","x":787.13,"y":-271,"w":159.37,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"p"},{"t":" data decay that can silently corrupt files over time.","x":9,"y":-252,"w":496.88,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"p"},{"t":"Even if someone remembers all your answers perfectly, a single missing byte can render your vault","x":9,"y":-217,"w":909.38,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"p"},{"t":" irretrievable. That's why secure, redundant storage is essential.","x":9,"y":-198,"w":609.38,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"p"},{"t":"What to Do Next","x":9,"y":-163,"w":140.63,"h":19,"c":"rgb(242, 242, 242)","fs":"16px","el":"h3","tt":"uppercase"},{"t":"Create a folder (e.g., ","x":31,"y":-125,"w":215.63,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"li"},{"t":"J's_Memoro_Vault","x":251.63,"y":-125,"w":150,"h":19,"c":"rgb(204, 204, 204)","fs":"16px","el":"code"},{"t":") on your computer.","x":406.63,"y":-125,"w":178.12,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"li"},{"t":"Place both of the following into that folder:\n              ","x":31,"y":-96,"w":421.88,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"li"},{"t":"The downloaded vault ZIP file","x":53,"y":-67,"w":271.88,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"li"},{"t":"The Memoro Vault installer (e.g., ","x":53,"y":-38,"w":318.75,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"li"},{"t":"memoro-win.exe","x":376.75,"y":-38,"w":131.25,"h":19,"c":"rgb(204, 204, 204)","fs":"16px","el":"code"},{"t":", ","x":513,"y":-38,"w":18.75,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"li"},{"t":".AppImage","x":536.75,"y":-38,"w":84.38,"h":19,"c":"rgb(204, 204, 204)","fs":"16px","el":"code"},{"t":", or ","x":626.13,"y":-38,"w":46.87,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"li"},{"t":".dmg","x":678,"y":-38,"w":37.5,"h":19,"c":"rgb(204, 204, 204)","fs":"16px","el":"code"},{"t":")","x":720.5,"y":-38,"w":9.38,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"li"},{"t":"Duplicate that folder to multiple destinations:","x":31,"y":-9,"w":440.63,"h":19,"c":"rgb(204, 204, 204)","fs":"16px","el":"strong"},{"t":"1× ","x":53,"y":20,"w":28.13,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"li"},{"t":"M-DISC","x":81.13,"y":20,"w":56.25,"h":19,"c":"rgb(204, 204, 204)","fs":"16px","el":"strong"},{"t":" (for long-term archival)","x":137.38,"y":20,"w":234.37,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"li"},{"t":"1× ","x":53,"y":49,"w":28.13,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"li"},{"t":"Cloud backup","x":81.13,"y":49,"w":112.5,"h":19,"c":"rgb(204, 204, 204)","fs":"16px","el":"strong"},{"t":" (e.g., Proton Drive or Google Drive)","x":193.63,"y":49,"w":346.87,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"li"},{"t":"1× ","x":53,"y":78,"w":28.13,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"li"},{"t":"Offline USB/SSD","x":81.13,"y":78,"w":140.62,"h":19,"c":"rgb(204, 204, 204)","fs":"16px","el":"strong"},{"t":" (stored in a fireproof safe or Faraday bag)","x":221.75,"y":78,"w":412.5,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"li"},{"t":"Create a paper backup (recommended):","x":31,"y":107,"w":337.5,"h":19,"c":"rgb(204, 204, 204)","fs":"16px","el":"strong"},{"t":"Memoro Vault can generate a printable PDF of QR codes that reassemble your encrypted vault.","x":53,"y":136,"w":853.13,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"li"},{"t":"Print these QR tiles on archival paper and store them in a secure location.","x":53,"y":165,"w":703.13,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"li"},{"t":"This ensures recovery even if all digital copies are lost or corrupted.","x":53,"y":194,"w":665.63,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"li"},{"t":"Test access on another device while offline to verify integrity and function.","x":31,"y":223,"w":721.88,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"li"},{"t":"Repeat this process whenever you update or rebuild your vault.","x":31,"y":252,"w":581.25,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"li"},{"t":"Why M-DISC?","x":9,"y":287,"w":103.13,"h":19,"c":"rgb(242, 242, 242)","fs":"16px","el":"h3","tt":"uppercase"},{"t":"M-DISCs use a permanent, stone-like recording layer, unlike dye-based DVDs or flash memory. They're","x":9,"y":325,"w":928.13,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"p"},{"t":" immune to bit rot, magnetic damage, EMPs, and most environmental degradation.","x":9,"y":344,"w":721.88,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"p"},{"t":"With proper storage, an M-DISC can last 100–1,000 years — making it ideal for preserving something","x":9,"y":379,"w":918.75,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"p"},{"t":" irreplaceable.","x":9,"y":398,"w":131.25,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"p"},{"t":"Final Advice","x":9,"y":433,"w":112.5,"h":19,"c":"rgb(242, 242, 242)","fs":"16px","el":"h3","tt":"uppercase"},{"t":"Do ","x":31,"y":471,"w":28.13,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"li"},{"t":"not","x":59.13,"y":471,"w":28.12,"h":19,"c":"rgb(204, 204, 204)","fs":"16px","el":"strong"},{"t":" rely on a single copy.","x":87.25,"y":471,"w":215.63,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"li"},{"t":"Do ","x":31,"y":500,"w":28.13,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"li"},{"t":"not","x":59.13,"y":500,"w":28.12,"h":19,"c":"rgb(204, 204, 204)","fs":"16px","el":"strong"},{"t":" trust cloud providers to exist forever.","x":87.25,"y":500,"w":375,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"li"},{"t":"Do ","x":31,"y":529,"w":28.13,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"li"},{"t":"not","x":59.13,"y":529,"w":28.12,"h":19,"c":"rgb(204, 204, 204)","fs":"16px","el":"strong"},{"t":" assume your future self will remember every step.","x":87.25,"y":529,"w":468.75,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"li"},{"t":"Redundancy is key to ensuring your vault remains accessible for generations to come.","x":9,"y":564,"w":787.5,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"p"},{"t":"A copy of these instructions is also included inside your vault ZIP as\n            ","x":9,"y":599,"w":665.63,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"p"},{"t":"Vault_Builder_Instructions.txt","x":679.63,"y":599,"w":281.25,"h":19,"c":"rgb(204, 204, 204)","fs":"16px","el":"code"},{"t":".\n          ","x":965.88,"y":599,"w":9.37,"h":19,"c":"rgb(168, 168, 168)","fs":"16px","el":"p"},{"t":"Got it","x":18.38,"y":644,"w":56.25,"h":19,"c":"rgb(204, 204, 204)","fs":"16px","el":"button.btn-primary","ws":"nowrap"}],"boxes":[{"el":"button","x":8,"y":114,"w":159.38,"h":19,"bg":"rgba(0, 0, 0, 0)","c":"rgb(204, 204, 204)","tag":"BUTTON","type":"submit","text":"Back to Answers","before":"\"[\"","after":"\